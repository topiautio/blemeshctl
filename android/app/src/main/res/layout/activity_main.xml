<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#12372a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#49655a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle"/>
        <TextView
            android:textColor="#12372a"
            android:id="@+id/statusText"
            android:background="#e5f4ec"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/initial_status"
            android:textIsSelectable="true"/>
        <ProgressBar
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:id="@+id/permissionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/bluetooth_permission"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/scanButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/scan_eight_seconds"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textStyle="bold"
            android:textColor="#12372a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/light"/>
        <Spinner
            android:id="@+id/deviceSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:contentDescription="@string/selected_light_description"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#49655a"
            android:id="@+id/deviceDetailsText"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_selected_device"
            android:textIsSelectable="true"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#12372a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/basic_controls"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/onButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/turn_on"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/offButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/turn_off"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <Button
                android:id="@+id/disconnectButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/disconnect"
                android:layout_weight="1.25"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textColor="#49655a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/colour_wheel_help"/>
        <io.github.topiautio.blemeshctl.color.ColorWheelView
            android:layout_gravity="center_horizontal"
            android:id="@+id/colorWheel"
            android:padding="4dp"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:contentDescription="@string/colour_wheel_description"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/colorPreview"
                android:background="@drawable/color_swatch"
                android:layout_width="48dp"
                android:layout_height="32dp"
                android:contentDescription="@string/selected_colour_preview"/>
            <TextView
                android:textColor="#49655a"
                android:id="@+id/colorSelectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/selected_colour"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <TextView
            android:textColor="#49655a"
            android:id="@+id/brightnessText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/brightness_initial"/>
        <SeekBar
            android:id="@+id/brightnessSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99"
            android:progress="99"/>
        <Button
            android:id="@+id/colorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_colour"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#12372a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/mesh_credentials"/>
        <EditText
            android:id="@+id/meshNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_mesh_name"
            android:hint="@string/mesh_name"
            android:maxLines="1"
            android:inputType="text"
            android:importantForAutofill="no"/>
        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/default_mesh_password"
            android:hint="@string/mesh_password"
            android:maxLines="1"
            android:inputType="textPassword"
            android:importantForAutofill="no"/>
        <TextView
            android:textStyle="bold"
            android:textColor="#12372a"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/script_heading"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#49655a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/script_help"/>
        <EditText
            android:gravity="start|top"
            android:id="@+id/scriptEditor"
            android:background="#ffffff"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="8dp"
            android:text="@string/default_script"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:importantForAutofill="no"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/loadCycleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/rgb_example"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/loadRainbowButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/rainbow_example"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <Button
                android:id="@+id/openScriptButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/open_file"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/runScriptButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/run_script"
                android:layout_weight="1"/>
            <Button
                android:enabled="false"
                android:id="@+id/stopScriptButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/stop_script"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#6b3f24"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/safety_note"/>
    </LinearLayout>
</ScrollView>
